# Public Client Environment Variables (Safe to bundle in Expo app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Server-Only Secrets (Set via `npx supabase secrets set GEMINI_API_KEY=...`, NEVER prefix with EXPO_PUBLIC_)
# GEMINI_API_KEY=your-gemini-api-key